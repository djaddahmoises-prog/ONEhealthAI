{
  "expo": {
    "name": "OneTouch Health",
    "slug": "onetouchhealth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0f0d"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.onetouchhealth.app",
      "infoPlist": {
        "NSCameraUsageDescription": "OneTouch Health needs camera access to measure your heart rate using your fingertip.",
        "NSPhotoLibraryUsageDescription": "OneTouch Health needs photo library access."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0f0d"
      },
      "package": "com.onetouchhealth.app",
      "permissions": ["CAMERA", "FLASHLIGHT"]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "OneTouch Health needs camera access to measure your heart rate."
        }
      ]
    ]
  }
}
